# Copiază în .env și completează. .env NU intră în git (vezi .gitignore).

# ── Hugging Face (pyannote diarization — model gated) ─────────────────────
# 1. Cont pe huggingface.co → acceptă termenii la pyannote/speaker-diarization-3.1
# 2. Settings → Access Tokens → creează un token "read"
HF_TOKEN=

# ── Porturi (Docker) ──────────────────────────────────────────────────────
VSR_UI_PORT=8080

# ── Registry + versiuni (Docker build/pull) ───────────────────────────────
# GHCR: ghcr.io/<user-github>/vsr   ·   Docker Hub: docker.io/<user>/vsr
IMAGE_PREFIX=ghcr.io/CHANGEME/vsr
TAG=latest

# ── Proveniență (stampată în imagini + în tabela jobs) ────────────────────
GIT_SHA=dev
